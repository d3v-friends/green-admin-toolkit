{
	"compilerOptions": {
		"target": "ES2017",
		"lib": ["dom", "dom.iterable", "esnext"],
		"allowJs": true,
		"skipLibCheck": true,
		"strict": true,
		"noEmit": true,
		"esModuleInterop": true,
		"module": "esnext",
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"isolatedModules": true,
		"jsx": "react-jsx",
		"incremental": true,
		"plugins": [
			{
				"name": "next"
			}
		],
		"paths": {
			"@app/*": ["./app/*"],
			"@app": ["./app"],
			"@src": ["./src"]
		}
	},
	"include": [
		"next-env.d.ts",
		".next/types/**/*.ts",
		"./src/*",
		"./app/*",
		".next/dev/types/**/*.ts",
		"src",
		"app",
		"asset"
	],
	"exclude": ["node_modules", "dist"]
}
